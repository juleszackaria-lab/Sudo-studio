{
  "name": "backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "npx nodemon server.js",
    "test": "node tests/run-all.js"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^7.0.1",
    "firebase-admin": "^11.5.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "lowdb": "^1.0.0",
    "socket.io": "^4.8.3",
    "winston": "^3.9.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  },
  "pkg": {
    "targets": [
      "node18-win-x64"
    ],
    "assets": [
      "data/**"
    ],
    "scripts": [
      "routes/**/*.js",
      "middleware/**/*.js",
      "models/**/*.js",
      "utils/**/*.js",
      "controllers/**/*.js",
      "security/**/*.js",
      "config/**/*.js",
      "supervisor/**/*.js"
    ]
  }
}
