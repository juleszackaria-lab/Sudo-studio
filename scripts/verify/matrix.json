{
  "version": 1,
  "title": "P36 - Matrice des prompts 1-35 sur le PAQUET INSTALLE",
  "gate": "Packaging FAILS if any evaluated line verdict is FAIL. unit/e2e-job lines are enforced by their own pre-existing gates (03 pins+01/02 gate, e2e step). panel-job lines are INFORMATIONAL (best-effort job, user decision 19/10). doc lines are SKIP (paper prompts, see (f) list).",
  "sources": {
    "p36": "run by scripts/verify/run-matrix.js on the installed package (this repo: test-*.js)",
    "smoke": "parsed by run-matrix.js from the 03 smoke summary.txt ([PASS]/[FAIL] lines)",
    "manifest": "checked by run-matrix.js (re-hash + shipped verify script execution)",
    "panel-job": "informational: 03 panel-render job (P35, best-effort); report reviewed, never fails packaging",
    "e2e-job": "external: 03 agent-e2e step (P31d) must be green; its failure fails packaging",
    "unit": "external: pre-existing 03 gate (01+02 green, pins==main) on the original suites",
    "doc": "SKIP: paper prompt (report/plan), not replayable on an installed package"
  },
  "lines": [
    {"id": "P36-AUDIT-4TYPES", "prompt": 36, "fonction": "audit secrets: 4 types detectes (sk-*, JWT_SECRET, 64-hex, postgres URL)", "marqueur": "src/utils/secretPatterns.js (Database URL ajoute P36)", "test": "test-security.js auditA-4-secret-types", "source": "p36", "verdict": "unproven", "preuve": ""},
    {"id": "P36-AUDIT-REDACT", "prompt": 36, "fonction": "audit secrets: aucun contenu brut au rapport (redaction)", "marqueur": "_scanSecrets -> [REDACTED]", "test": "test-security.js auditA-redaction", "source": "p36", "verdict": "unproven", "preuve": ""},
    {"id": "P36-AUDIT-GITIGNORE", "prompt": 36, "fonction": ".gitignore recommande quand secret non ignore", "marqueur": "GITIGNORE_SENSITIVE (8 entrees)", "test": "test-security.js auditA-gitignore-recommended", "source": "p36", "verdict": "unproven", "preuve": ""},
    {"id": "P36-AUDIT-VULN", "prompt": 36, "fonction": "dependance vulnerable signalee (lodash CVE-2020-8203)", "marqueur": "src/utils/localAudit.js + src/data/advisories.json", "test": "test-security.js auditA-vuln-flagged", "source": "p36", "verdict": "unproven", "preuve": ""},
    {"id": "P36-AUDIT-SCORE", "prompt": 36, "fonction": "score de securite present (0-100)", "marqueur": "computeSecurityScore", "test": "test-security.js auditA-score", "source": "p36", "verdict": "unproven", "preuve": ""},
    {"id": "P36-AUDIT-NODB", "prompt": 36, "fonction": "base absente/corrompue = non evaluee, sans erreur (+fallback embedded)", "marqueur": "missingDb/missingText 'non evaluees'", "test": "test-security.js auditB + auditC + auditC2", "source": "p36", "verdict": "unproven", "preuve": ""},
    {"id": "P36-DOCTOR-TOOLS", "prompt": 36, "fonction": "Doctor: versions outils == commandes shell independantes", "marqueur": "DoctorPanel._gatherDiagnostics vs execSync", "test": "test-doctor.js tool-Node.js/npm/Python/pip/Git/Docker", "source": "p36", "verdict": "unproven", "preuve": ""},
    {"id": "P36-DOCTOR-BACKEND", "prompt": 36, "fonction": "Doctor voit le backend demarre (port 5000)", "marqueur": "Backend (port 5000) ok", "test": "test-doctor.js backend-consistent --require-backend", "source": "p36", "verdict": "unproven", "preuve": ""},
