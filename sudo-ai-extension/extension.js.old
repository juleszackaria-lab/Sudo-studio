/**
 * SUDO STUDIO - ENTERPRISE AI PLATFORM
 * Extension VSCode complète avec toutes fonctionnalités backend connectées
 */

const vscode = require('vscode');
const { getBackendService } = require('./src/services/BackendService');
const { getStateManager } = require('./src/services/StateManager');
const { DashboardProvider } = require('./src/providers/DashboardProvider');

// Global instances
let backend, state, context;
let chatPanel, dashboardPanel, doctorPanel;
let dashboardProvider;

/**
 * Extension activation
 */
async function activate(ctx) {
    context = ctx;
    console.log('🚀 Sudo Studio activating...');

    // Initialize services
    backend = getBackendService();
    state = getStateManager();

    // Initialize backend connection
    await initializeBackend();

    // Register providers
    registerProviders();

    // Register commands
    registerCommands();

    // Show welcome message
    vscode.window.showInformationMessage('🚀 Sudo Studio activated! AI Platform ready.');

    console.log('✅ Sudo Studio activated successfully!');
}

/**
 * Initialize backend connection
 */
async function initializeBackend() {
    try {
        const connected = await backend.initialize();
        
        if (connected) {
            vscode.window.showInformationMessage('✅ Connected to Sudo Studio backend');
            
            // Check runtime status
            const runtimeHealth = await backend.checkRuntimeHealth();
            state.updateRuntimeState({
                status: runtimeHealth.status || 'unknown',
                modelLoaded: runtimeHealth.model_loaded || runtimeHealth.model?.loaded || false,
                modelName: runtimeHealth.loaded_model || runtimeHealth.model?.name || null
            });
            
            if (runtimeHealth.model_loaded || runtimeHealth.model?.loaded) {
                vscode.window.showInformationMessage(
                    `✅ AI Runtime ready with model: ${runtimeHealth.loaded_model || runtimeHealth.model.name}`
                );
            }
        } else {
            vscode.window.showWarningMessage(
                '⚠️ Backend offline. Start backend: cd backend && node server.js'
            );
        }
    } catch (error) {
        console.error('Backend initialization error:', error);
        vscode.window.showErrorMessage(`❌ Backend error: ${error.message}`);
    }
}

/**
 * Register tree view providers
 */
function registerProviders() {
    // Dashboard Provider
    dashboardProvider = new DashboardProvider();
    vscode.window.registerTreeDataProvider('sudoStudioDashboard', dashboardProvider);
}

/**
 * Register all commands
 */
function registerCommands() {
    const commands = [
        // Dashboard
        ['sudoStudio.openDashboard', openDashboard],
        
        // AI Chat
        ['sudoStudio.openChat', openChat],
        ['sudoStudio.selectModel', selectModel],
        ['sudoStudio.refreshModels', refreshModels],
        
        // Code actions
        ['sudoStudio.explainCode', explainCode],
        ['sudoStudio.fixCode', fixCode],
        ['sudoStudio.refactorCode', refactorCode],
        ['sudoStudio.generateCode', generateCode],
        
        // System Doctor
        ['sudoStudio.runDoctor', runDoctor],
        ['sudoStudio.autoFix', autoFix],
        ['sudoStudio.checkHealth', checkHealth],
        
        // SDK Management
        ['sudoStudio.installSDK', installSDK],
        ['sudoStudio.refreshSDKs', refreshSDKs],
        
        // DevOps
        ['sudoStudio.generateDocker', generateDocker],
        ['sudoStudio.generateCICD', generateCICD],
        
        // Environment
        ['sudoStudio.exportEnvironment', exportEnvironment],
        ['sudoStudio.importEnvironment', importEnvironment],
        
        // Project
        ['sudoStudio.analyzeProject', analyzeProject],
        
        // Runtime
        ['sudoStudio.restartRuntime', restartRuntime],
        
        // Settings
        ['sudoStudio.openSettings', openSettings],
        ['sudoStudio.showOnboarding', showOnboarding]
    ];

    commands.forEach(([command, handler]) => {
        context.subscriptions.push(
            vscode.commands.registerCommand(command, handler)
        );
    });
}

