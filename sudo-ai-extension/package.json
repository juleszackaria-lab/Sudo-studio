{
  "name": "sudo-studio",
  "displayName": "Sudo Studio - Enterprise AI Platform",
  "description": "Enterprise-grade AI development platform with local models, SDK management, system doctor, and DevOps automation",
  "version": "2.1.0",
  "publisher": "sudo-studio",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Debuggers",
    "Testing",
    "Other"
  ],
  "keywords": [
    "ai",
    "assistant",
    "enterprise",
    "devops",
    "sdk-manager",
    "system-doctor",
    "local-ai",
    "automation"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sudo-studio",
          "title": "Sudo Studio",
          "icon": {
            "light": "resources/sudo-robot.svg",
            "dark": "resources/sudo-robot.svg"
          }
        }
      ]
    },
    "views": {
      "sudo-studio": [
        {
          "id": "sudoAgentLauncher",
          "name": "Sudo Agent",
          "icon": "$(comment-discussion)",
          "contextualTitle": "Sudo Agent"
        },
        {
          "id": "sudoStudioDashboard",
          "name": "Dashboard",
          "icon": "$(dashboard)",
          "contextualTitle": "Sudo Studio Dashboard"
        },
        {
          "id": "sudoStudio",
          "name": "Sudo Studio",
          "icon": "$(home)",
          "contextualTitle": "Sudo Studio"
        },
        {
          "id": "sudoStudioEnvironment",
          "name": "🔒 Environment",
          "icon": "$(server-environment)",
          "contextualTitle": "Environment Manager"
        },
        {
          "id": "sudoStudioSecurity",
          "name": "🔒 Security"
        },
        {
          "id": "sudoStudioDuplication",
          "name": "📋 Duplication"
        },
        {
          "id": "sudoStudioCentral",
          "name": "⚙️ Central"
        },
        {
          "id": "sudoStudioLicense",
          "name": "🔑 License"
        }
      ]
    },
    "commands": [
      {
        "command": "sudoStudio.openDashboard",
        "title": "Open Dashboard",
        "category": "Sudo Studio",
        "icon": "$(dashboard)"
      },
      {
        "command": "sudoStudio.openChat",
        "title": "Open AI Chat",
        "category": "Sudo Studio",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "sudoStudio.runDoctor",
        "title": "Run System Doctor",
        "category": "Sudo Studio",
        "icon": "$(pulse)"
      },
      {
        "command": "sudoStudio.autoFix",
        "title": "Auto Fix Issues",
        "category": "Sudo Studio",
        "icon": "$(tools)"
      },
      {
        "command": "sudoStudio.installSDK",
        "title": "Install SDK",
        "category": "Sudo Studio",
        "icon": "$(cloud-download)"
      },
      {
        "command": "sudoStudio.refreshSDKs",
        "title": "Refresh SDKs",
        "category": "Sudo Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "sudoStudio.generateDocker",
        "title": "Generate Dockerfile",
        "category": "Sudo Studio",
        "icon": "$(file-code)"
      },
      {
        "command": "sudoStudio.generateCICD",
        "title": "Generate CI/CD Pipeline",
        "category": "Sudo Studio",
        "icon": "$(file-code)"
      },
      {
        "command": "sudoStudio.exportEnvironment",
        "title": "Export Environment",
        "category": "Sudo Studio",
        "icon": "$(export)"
      },
      {
        "command": "sudoStudio.importEnvironment",
        "title": "Import Environment",
        "category": "Sudo Studio",
        "icon": "$(import)"
      },
      {
        "command": "sudoStudio.createSnapshot",
        "title": "Create Snapshot",
        "category": "Sudo Studio",
        "icon": "$(save)"
      },
      {
        "command": "sudoStudio.backupEnvironment",
        "title": "Backup Environment",
        "category": "Sudo Studio",
        "icon": "$(database)"
      },
      {
        "command": "sudoStudio.restoreEnvironment",
        "title": "Restore Environment",
        "category": "Sudo Studio",
        "icon": "$(history)"
      },
      {
        "command": "sudoStudio.cloneEnvironment",
        "title": "Clone Environment",
        "category": "Sudo Studio",
        "icon": "$(copy)"
      },
      {
        "command": "sudoStudio.analyzeProject",
        "title": "Analyze Project",
        "category": "Sudo Studio",
        "icon": "$(search)"
      },
      {
        "command": "sudoStudio.explainCode",
        "title": "Explain Code (AI)",
        "category": "Sudo Studio",
        "icon": "$(lightbulb)"
      },
      {
        "command": "sudoStudio.fixCode",
        "title": "Fix Code (AI)",
        "category": "Sudo Studio",
        "icon": "$(tools)"
      },
      {
        "command": "sudoStudio.refactorCode",
        "title": "Refactor Code (AI)",
        "category": "Sudo Studio",
        "icon": "$(edit)"
      },
      {
        "command": "sudoStudio.generateCode",
        "title": "Generate Code (AI)",
        "category": "Sudo Studio",
        "icon": "$(add)"
      },
      {
        "command": "sudoStudio.generateTests",
        "title": "Generate Tests (AI)",
        "category": "Sudo Studio",
        "icon": "$(beaker)"
      },
      {
        "command": "sudoStudio.addComments",
        "title": "Add Comments (AI)",
        "category": "Sudo Studio",
        "icon": "$(comment)"
      },
      {
        "command": "sudoStudio.selectModel",
        "title": "Select AI Model",
        "category": "Sudo Studio",
        "icon": "$(symbol-method)"
      },
      {
        "command": "sudoStudio.refreshModels",
        "title": "Refresh Models",
        "category": "Sudo Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "sudoStudio.restartRuntime",
        "title": "Restart AI Runtime",
        "category": "Sudo Studio",
        "icon": "$(debug-restart)"
      },
      {
        "command": "sudoStudio.checkRuntimeHealth",
        "title": "Check Runtime Health",
        "category": "Sudo Studio",
        "icon": "$(pulse)"
      },
      {
        "command": "sudoStudio.reloadModel",
        "title": "Reload AI Model",
        "category": "Sudo Studio",
        "icon": "$(sync)"
      },
      {
        "command": "sudoStudio.clearRuntimeCache",
        "title": "Clear Runtime Cache",
        "category": "Sudo Studio",
        "icon": "$(trash)"
      },
      {
        "command": "sudoStudio.viewRuntimeLogs",
        "title": "View Runtime Logs",
        "category": "Sudo Studio",
        "icon": "$(output)"
      },
      {
        "command": "sudoStudio.clearChatHistory",
        "title": "Clear Chat History",
        "category": "Sudo Studio",
        "icon": "$(trash)"
      },
      {
        "command": "sudoStudio.openProvidersPanel",
        "title": "Open AI Providers Page",
        "category": "Sudo Studio",
        "icon": "$(plug)"
      },
      {
        "command": "sudoStudio.selectAIProvider",
        "title": "Select Active AI Provider",
        "category": "Sudo Studio",
        "icon": "$(list-selection)"
      },
      {
        "command": "sudoStudio.openRuntimePanel",
        "title": "Open Runtime & Models Panel",
        "category": "Sudo Studio",
        "icon": "$(server-process)"
      },
      {
        "command": "sudoStudio.openDevOpsPanel",
        "title": "Open DevOps Automation Panel",
        "category": "Sudo Studio",
        "icon": "$(rocket)"
      },
      {
        "command": "sudoStudio.openAnalysisPanel",
        "title": "Analyze Project (Full Panel)",
        "category": "Sudo Studio",
        "icon": "$(search)"
      },
      {
        "command": "sudoStudio.openSDKPanel",
        "title": "Open SDK Manager Panel",
        "category": "Sudo Studio",
        "icon": "$(package)"
      },
      {
        "command": "sudoStudio.openEnvironmentPanel",
        "title": "Open Reproductible Environments Panel",
        "category": "Sudo Studio",
        "icon": "$(sync)"
      },
      {
        "command": "sudoStudio.openAgentPanel",
        "title": "Sudo Agent",
        "category": "Sudo Studio",
        "icon": "$(robot)"
      },
      {
        "command": "sudoAgent.open",
        "title": "Sudo Agent: Ouvrir",
        "category": "Sudo Studio",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "sudoAgent.stop",
        "title": "Sudo Agent: Arreter",
        "category": "Sudo Studio",
        "icon": "$(debug-stop)"
      },
      {
        "command": "sudoStudio.refreshDashboard",
        "title": "Refresh Dashboard",
        "category": "Sudo Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "sudoStudio.generateDockerCompose",
        "title": "Sudo AI: Generate Docker Compose",
        "category": "Sudo Studio"
      },
      {
        "command": "sudoStudio.generateKubernetes",
        "title": "Sudo AI: Generate Kubernetes Config",
        "category": "Sudo Studio"
      },
      {
        "command": "sudoStudio.buildDocker",
        "title": "Sudo AI: Build Docker Image",
        "category": "Sudo Studio"
      },
      {
        "command": "sudoStudio.optimizeDocker",
        "title": "Sudo AI: Optimize Dockerfile",
        "category": "Sudo Studio"
      },
      {
        "command": "sudoStudio.applyTemplate",
        "title": "Sudo AI: Apply Project Template",
        "category": "Sudo Studio"
      },
      {
        "command": "sudoStudio.openLogsFolder",
        "title": "Sudo : Ouvrir le dossier des journaux",
        "category": "Sudo Studio",
        "icon": "$(output)"
      },
      {
        "command": "sudoStudio.openLogsViewer",
        "title": "Sudo : Voir les journaux",
        "category": "Sudo Studio",
        "icon": "$(list-filter)"
      },
      {
        "command": "sudoStudio.exportDiagnostics",
        "title": "Sudo : Exporter le diagnostic",
        "category": "Sudo Studio",
        "icon": "$(package)"
      },
      {
        "command": "sudoStudio.openSecurityPanel",
        "title": "🔒 Security Audit",
        "category": "Sudo Studio",
        "icon": "$(shield)"
      },
      {
        "command": "sudoStudio.openDuplicationPanel",
        "title": "📋 Enterprise Duplication",
        "category": "Sudo Studio",
        "icon": "$(copy)"
      },
      {
        "command": "sudoStudio.openCentralMgmtPanel",
        "title": "⚙️ Central Management",
        "category": "Sudo Studio",
        "icon": "$(settings-gear)"
      },
      {
        "command": "sudoStudio.openAuditLog",
        "title": "Open Audit Log",
        "category": "Sudo Studio",
        "icon": "$(history)"
      },
      {
        "command": "sudoStudio.openLicensePanel",
        "title": "🔑 License Management",
        "category": "Sudo Studio",
        "icon": "$(key)"
      },
      {
        "command": "sudoStudio.openSdkInstallPanel",
        "title": "⬇ SDK Install",
        "category": "Sudo Studio"
      },
      {
        "command": "sudoStudio.runSecurityAudit",
        "title": "🔒 Run Security Audit",
        "category": "Sudo Studio",
        "icon": "$(play)"
      },
      {
        "command": "sudoStudio.cloneEnterprise",
        "title": "📋 Clone Enterprise Env",
        "category": "Sudo Studio",
        "icon": "$(repo-clone)"
      },
      {
        "command": "sudoStudio.showBuildInfo",
        "title": "A propos du build",
        "category": "Sudo",
        "icon": "$(info)"
      },
      {
        "command": "sudoStudio.resetLayout",
        "title": "Réinitialiser la disposition",
        "category": "Sudo",
        "icon": "$(layout)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "sudoStudio.explainCode",
          "when": "editorHasSelection",
          "group": "sudo-studio@1"
        },
        {
          "command": "sudoStudio.fixCode",
          "when": "editorHasSelection",
          "group": "sudo-studio@2"
        },
        {
          "command": "sudoStudio.refactorCode",
          "when": "editorHasSelection",
          "group": "sudo-studio@3"
        },
        {
          "command": "sudoStudio.generateTests",
          "when": "editorHasSelection",
          "group": "sudo-studio@4"
        },
        {
          "command": "sudoStudio.addComments",
          "when": "editorHasSelection",
          "group": "sudo-studio@5"
        }
      ],
      "view/title": [
        {
          "command": "sudoStudio.openChat",
          "when": "view == sudoStudioDashboard",
          "group": "navigation@1"
        },
        {
          "command": "sudoStudio.refreshDashboard",
          "when": "view == sudoStudioDashboard",
          "group": "navigation@2"
        },
        {
          "command": "sudoStudio.exportEnvironment",
          "when": "view == sudoStudioEnvironment",
          "group": "navigation@1"
        },
        {
          "command": "sudoStudio.createSnapshot",
          "when": "view == sudoStudioEnvironment",
          "group": "navigation@2"
        },
        {
          "command": "sudoStudio.backupEnvironment",
          "when": "view == sudoStudioEnvironment",
          "group": "navigation@3"
        },
        {
          "command": "sudoStudio.restoreEnvironment",
          "when": "view == sudoStudioEnvironment",
          "group": "navigation@4"
        },
        {
          "command": "sudoStudio.openSecurityPanel",
          "when": "view == sudoStudioSecurity",
          "group": "navigation@1"
        },
        {
          "command": "sudoStudio.runSecurityAudit",
          "when": "view == sudoStudioSecurity",
          "group": "navigation@2"
        },
        {
          "command": "sudoStudio.openDuplicationPanel",
          "when": "view == sudoStudioDuplication",
          "group": "navigation@1"
        },
        {
          "command": "sudoStudio.cloneEnterprise",
          "when": "view == sudoStudioDuplication",
          "group": "navigation@2"
        },
        {
          "command": "sudoStudio.openCentralMgmtPanel",
          "when": "view == sudoStudioCentral",
          "group": "navigation@1"
        },
        {
          "command": "sudoStudio.openLicensePanel",
          "when": "view == sudoStudioLicense",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "sudoStudio.explainCode",
          "when": "editorHasSelection"
        },
        {
          "command": "sudoStudio.fixCode",
          "when": "editorHasSelection"
        },
        {
          "command": "sudoStudio.refactorCode",
          "when": "editorHasSelection"
        },
        {
          "command": "sudoStudio.generateTests",
          "when": "editorHasSelection"
        },
        {
          "command": "sudoStudio.addComments",
          "when": "editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "Sudo Studio",
      "properties": {
        "sudoStudio.backendUrl": {
          "type": "string",
          "default": "http://localhost:5000",
          "description": "URL of the Sudo Studio backend server"
        },
        "sudoStudio.offlineInstallersDir": {
          "type": "string",
          "default": "",
          "description": "Offline installers folder used by AutoFix when there is no Internet (empty = ~/.sudo_studio/installers). Each installer requires a .sha256 sidecar."
        },
        "sudoStudio.runtimeUrl": {
          "type": "string",
          "default": "http://127.0.0.1:6000",
          "description": "URL of the Python AI runtime server"
        }

      }
    },
    "keybindings": [
      {
        "command": "sudoAgent.open",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "!terminalFocus"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "node ../backend/tests/run-all.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^20.x",
    "eslint": "^8.x",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "marked": "^9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/juleszackaria-lab/Sudo-studio.git"
  },
  "bugs": {
    "url": "https://github.com/juleszackaria-lab/Sudo-studio/issues"
  },
  "homepage": "https://github.com/juleszackaria-lab/Sudo-studio#readme",
  "license": "UNLICENSED"
}
